# =============================================================================
# GitCompass 404 — Environment Configuration
# =============================================================================
# Copy this file to .env.local and populate your credentials.
# Note: Credentials can also be configured at runtime inside the UI API Settings.

# Google Gemini API Key for Google Gemma 4 (Text + Multimodal Vision)
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Active Google Gemma 4 Model Identifier
GEMMA_MODEL=gemma-4-26b-a4b-it

# Optional: GitHub Personal Access Token (PAT) to elevate rate limits from 60 to 5,000 req/hr
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=optional_github_pat_for_higher_rate_limits

# Optional: Maximum screenshot upload size in megabytes
MAX_IMAGE_MB=4

# Optional: Maximum API requests per minute from a single IP
RATE_LIMIT_PER_MIN=20
