# Copy this file to .env.local and fill in your own values.
# Never commit .env.local. It is already listed in .gitignore.

# Required. Your Gemini API key, used to call Gemma models.
# Get one for free at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Required. The Gemma model selected by default in the model dropdown.
# The app lists every Gemma model your key can use, so you can switch in the UI.
# To see the names yourself, run:
#   curl "https://generativelanguage.googleapis.com/v1beta/models?key=YOUR_KEY"
# and pick a "gemma-..." model that supports images (needed for bug reports).
GEMMA_MODEL=

# Optional but recommended. A GitHub token raises the GitHub API limit from
# 60 to 5,000 requests per hour. A fine-grained token with no extra
# permissions (public repositories, read-only) is enough.
# Create one at https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=

# Optional. Maximum screenshot upload size in megabytes (default 4).
MAX_IMAGE_MB=4

# Optional. Maximum API requests per minute from one IP address (default 20).
RATE_LIMIT_PER_MIN=20
